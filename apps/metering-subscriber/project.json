{
  "name": "metering-subscriber",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/metering-subscriber/src",
  "projectType": "application",
  "tags": ["scope:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/metering-subscriber"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      },
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"]
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "metering-subscriber:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "metering-subscriber:build:development"
        },
        "production": {
          "buildTarget": "metering-subscriber:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/metering-subscriber/**/*.{ts,js}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p apps/metering-subscriber/tsconfig.app.json",
          "tsc --noEmit -p apps/metering-subscriber/tsconfig.spec.json"
        ]
      }
    },
    "test-unit": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/metering-subscriber/jest.config.ts"
      }
    }
  }
}
