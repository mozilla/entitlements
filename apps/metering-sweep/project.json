{
  "name": "metering-sweep",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/metering-sweep/src",
  "projectType": "application",
  "tags": ["scope:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/metering-sweep"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      },
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"]
    },
    "run": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "params": "forward"
        }
      ],
      "options": {
        "command": "node dist/apps/metering-sweep/main.js"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/metering-sweep/**/*.{ts,js}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p apps/metering-sweep/tsconfig.app.json",
          "tsc --noEmit -p apps/metering-sweep/tsconfig.spec.json"
        ]
      }
    },
    "test-unit": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/metering-sweep/jest.config.ts"
      }
    }
  }
}
