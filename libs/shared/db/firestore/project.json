{
  "name": "shared-db-firestore",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/db/firestore/src",
  "projectType": "library",
  "tags": ["scope:lib"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/shared/db/firestore/**/*.ts",
          "libs/shared/db/firestore/package.json"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/shared/db/firestore/tsconfig.lib.json",
          "tsc --noEmit -p libs/shared/db/firestore/tsconfig.spec.json"
        ]
      }
    },
    "test-unit": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/db/firestore/jest.config.ts"
      }
    }
  }
}
