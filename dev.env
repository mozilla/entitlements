# Local development defaults, loaded by docker compose and by each app.
# Hostnames refer to docker compose services. Put personal overrides and
# secrets in dev.local.env (gitignored), never in this file.

# Strapi Config
STRAPI_CLIENT_CONFIG__GRAPHQL_API_URI=http://host.docker.internal:1337/graphql
STRAPI_CLIENT_CONFIG__API_KEY=PLACEHOLDER
STRAPI_CLIENT_CONFIG__MEM_CACHE_T_T_L=
STRAPI_CLIENT_CONFIG__FIRESTORE_CACHE_COLLECTION_NAME=strapiClientQueryCacheCollection
STRAPI_CLIENT_CONFIG__FIRESTORE_CACHE_T_T_L=
STRAPI_CLIENT_CONFIG__FIRESTORE_OFFLINE_CACHE_T_T_L=

# Firestore Config
FIRESTORE_EMULATOR_HOST=firebase:9090
FIRESTORE_CONFIG__CREDENTIALS__CLIENT_EMAIL=
FIRESTORE_CONFIG__CREDENTIALS__PRIVATE_KEY=
FIRESTORE_CONFIG__KEY_FILENAME=
FIRESTORE_CONFIG__PROJECT_ID=

# StatsD Config
STATS_D_CONFIG__SAMPLE_RATE=
STATS_D_CONFIG__MAX_BUFFER_SIZE=
STATS_D_CONFIG__HOST=
STATS_D_CONFIG__PORT=
STATS_D_CONFIG__PREFIX=

# Metering Config
METERING_CONFIG__CLIENTS={"local-rp":"local-dev-secret"}
METERING_CONFIG__USAGE_GRANTS__FIRESTORE_COLLECTION_NAME=metering-usage-grants
METERING_CONFIG__CLICKHOUSE__URL=http://clickhouse:8123
METERING_CONFIG__CLICKHOUSE__DATABASE=metering
METERING_CONFIG__CLICKHOUSE__USERNAME=metering_rw
METERING_CONFIG__CLICKHOUSE__PASSWORD=local_metering_dev
METERING_CONFIG__CLICKHOUSE__REQUEST_TIMEOUT_MS=10000
METERING_CONFIG__CLICKHOUSE__MAX_EXECUTION_TIME_SECONDS=10
METERING_CONFIG__CLICKHOUSE__MAX_THREADS=2
METERING_CONFIG__CLICKHOUSE__MAX_MEMORY_USAGE_BYTES=268435456
METERING_CONFIG__CLICKHOUSE__MAX_BYTES_BEFORE_EXTERNAL_GROUP_BY=134217728
METERING_CONFIG__FIRESTORE__DATABASE_ID=entitlements-platform-local
METERING_CONFIG__FIRESTORE__PROJECT_ID=proj_123
METERING_CONFIG__PUBSUB__PROJECT_ID=test
METERING_CONFIG__PUBSUB__TOPIC_NAME=metering-events
METERING_CONFIG__PUBSUB__SUBSCRIPTION_NAME=metering-events-clickhouse
METERING_CONFIG__PUBSUB__EMULATOR_HOST=firebase:8085
METERING_CONFIG__PUBSUB__PUBLISH_BATCH_SIZE=100
METERING_CONFIG__PUBSUB__PUBLISH_BATCH_INTERVAL_MS=50
METERING_CONFIG__PUBSUB__CONSUMER_BATCH_SIZE=1000
METERING_CONFIG__PUBSUB__CONSUMER_FLUSH_INTERVAL_MS=5000
METERING_CONFIG__PUBSUB__MAX_OUTSTANDING_MESSAGES=5000
METERING_CONFIG__REDIS__HOST=redis
METERING_CONFIG__REDIS__PORT=6379
METERING_CONFIG__REDIS__KEY_PREFIX=metering:dedupe:
METERING_CONFIG__REDIS__CLAIM_TTL_SECONDS=60
METERING_CONFIG__REDIS__DEDUPE_TTL_SECONDS=90000
METERING_CONFIG__SWEEP__LOOKBACK_MS=90000
METERING_CONFIG__SWEEP__COOLDOWN_MS=3600000
METERING_CONFIG__SWEEP__DISPATCH_CONCURRENCY=20
METERING_CONFIG__SWEEP__WATERMARK_LAG_MS=30000

# Sentry Config
SENTRY_CONFIG__DSN=
SENTRY_CONFIG__ENV=local
SENTRY_CONFIG__SERVER_NAME=entitlements
SENTRY_CONFIG__SAMPLE_RATE=1
SENTRY_CONFIG__TRACES_SAMPLE_RATE=0

SWAGGER_UI=true

LOG_LEVEL=debug
